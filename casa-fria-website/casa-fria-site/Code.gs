const SHEET_NAME='Reservations';
function doGet(){return ContentService.createTextOutput(JSON.stringify({ok:true,message:'Casa Fria booking endpoint online'})).setMimeType(ContentService.MimeType.JSON)}
function doPost(e){const lock=LockService.getScriptLock();lock.waitLock(30000);try{const p=JSON.parse(e.postData.contents||'{}');if(p.type!=='reservation')throw new Error('Invalid request');const name=clean(p.name),phone=clean(p.phone),date=clean(p.date),pkg=clean(p.package);const guests=Math.max(1,Number(p.guests)||0);if(!name||!phone||!date||!pkg)throw new Error('Missing required fields');if(!/^\d{4}-\d{2}-\d{2}$/.test(date))throw new Error('Invalid date');const ss=SpreadsheetApp.getActive(),sh=ss.getSheetByName(SHEET_NAME)||ss.insertSheet(SHEET_NAME);if(sh.getLastRow()===0)sh.appendRow(['Reference','Created','Name','Phone','Date','Package','Guests','Event','Notes','Status']);const values=sh.getDataRange().getValues();const conflict=values.slice(1).some(r=>String(r[4])===date&&String(r[9]).toUpperCase()!=='DECLINED');if(conflict)throw new Error('That date already has an active request. Please contact Casa Fria to confirm availability.');const ref='CF-'+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyyMMdd-HHmmss');sh.appendRow([ref,new Date(),name,phone,date,pkg,guests,clean(p.event),clean(p.notes),'REQUEST']);return json({ok:true,reference:ref})}catch(err){return json({ok:false,error:err.message})}finally{lock.releaseLock()}}
function clean(v){return String(v??'').replace(/[\r\n]+/g,' ').replace(/^([=+\-@])/,'\'$1').trim()}
function json(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
